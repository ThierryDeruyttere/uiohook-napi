+// Cached copy of the current keyboard layout's uchr data, owned by this cache.
+// UCKeyTranslate is a pure function over these bytes, so with a cached copy the
+// HOOK thread translates keycodes itself, without any main-thread help. Before
+// this cache, every keydown dispatch_sync'd to the host app's main queue just
+// to fetch the layout (the TIS calls are not main-thread-safe) — in an Electron
+// host, a busy main thread held every keystroke hostage (active tap) until
+// kCGEventTapDisabledByTimeout froze typing system-wide. The cache is refreshed
+// ON the main thread (primed at hook start, re-checked via a coalesced
+// dispatch_async per keydown), so a layout switch propagates within a keystroke
+// and the tap callback never blocks. The mutex also serializes deadkey_state,
+// which is read/written by the translating thread and reset on layout change.
+static pthread_mutex_t layout_cache_mutex = PTHREAD_MUTEX_INITIALIZER;
+static CFDataRef cached_layout_data = NULL;
+
+// MUST run on the main runloop: TISCopyCurrentKeyboardLayoutInputSource off the
+// main thread causes sporadic "Exception detected while handling key input" and
+// TSMProcessRawKeyCode failed (-192) errors (the reason the dispatch-to-main
+// machinery existed). Copies the current layout's uchr bytes into the cache.
+void refresh_keyboard_layout_cache() {
+    TISInputSourceRef curr_keyboard_layout = TISCopyCurrentKeyboardLayoutInputSource();
+    if (curr_keyboard_layout != NULL && CFGetTypeID(curr_keyboard_layout) == TISInputSourceGetTypeID()) {
+        CFDataRef data = (CFDataRef) TISGetInputSourceProperty(curr_keyboard_layout, kTISPropertyUnicodeKeyLayoutData);
+        if (data != NULL && CFGetTypeID(data) == CFDataGetTypeID() && CFDataGetLength(data) > 0) {
+            pthread_mutex_lock(&layout_cache_mutex);
+            if (cached_layout_data == NULL || CFEqual(data, cached_layout_data) == false) {
+                if (cached_layout_data != NULL) {
+                    CFRelease(cached_layout_data);
+                    // The layout changed: any pending dead-key sequence belongs
+                    // to the old layout.
+                    deadkey_state = 0x00;
+                }
+                cached_layout_data = CFDataCreateCopy(kCFAllocatorDefault, data);
+            }
+            pthread_mutex_unlock(&layout_cache_mutex);
+        }
+    }
